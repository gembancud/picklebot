{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picklebot.local/schemas/phase1b-closing-summary-v0.json",
  "title": "Picklebot Phase 1B closing summary",
  "type": "object",
  "required": [
    "evidenceState",
    "closeEligible",
    "environmentVersion",
    "environmentTag",
    "configurationVersion",
    "calibrationState",
    "configurationHash",
    "physicsSettingsHash",
    "phase1CProtocolVersion",
    "phase1CProtocolHash",
    "sourceCommit",
    "unityVersion",
    "platform",
    "hardware",
    "generatedAtUtc",
    "gates",
    "artifactSha256",
    "referenceSha256",
    "limitations"
  ],
  "properties": {
    "evidenceState": { "const": "closing-source-exact" },
    "closeEligible": { "const": true },
    "environmentVersion": { "const": "env-v1" },
    "environmentTag": { "const": "env-v1" },
    "configurationVersion": { "const": "physics-calibration-v0" },
    "calibrationState": {
      "type": "string",
      "minLength": 1,
      "not": { "const": "provisional-unfitted" }
    },
    "configurationHash": { "type": "string", "minLength": 1 },
    "physicsSettingsHash": { "type": "string", "minLength": 1 },
    "phase1CProtocolVersion": { "const": "phase1c-protocol-v0" },
    "phase1CProtocolHash": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "unityVersion": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "hardware": { "type": "string", "minLength": 1 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "gates": {
      "type": "object",
      "required": [
        "geometry",
        "officialBallDrop",
        "acrylicCourtReference",
        "flightTrajectories",
        "paddleSurrogate",
        "courtAndNetContacts",
        "determinismAndStability",
        "readinessAndAllocation",
        "sourceExactReproduction",
        "envV1Freeze",
        "phase1CProtocol"
      ],
      "additionalProperties": { "$ref": "#/$defs/gate" }
    },
    "artifactSha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "referenceSha256": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["passed", "evidence"],
      "properties": {
        "passed": { "const": true },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
