{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picklebot.local/schemas/phase1b-closing-calibration-manifest-v0.json",
  "title": "Picklebot Phase 1B closing calibration manifest",
  "type": "object",
  "required": [
    "profile",
    "calibrationState",
    "generatedAtUtc",
    "qualifiesForClose",
    "limitations",
    "parameters"
  ],
  "properties": {
    "profile": { "const": "outdoor-40-hole-v0" },
    "calibrationState": {
      "type": "string",
      "minLength": 1,
      "not": { "const": "provisional-unfitted" }
    },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "qualifiesForClose": { "const": true },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "parameters": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "value",
          "unit",
          "sourceKind",
          "source",
          "fittingMethod",
          "standardUncertainty",
          "calibratedAt",
          "status"
        ],
        "properties": {
          "parameter": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "sourceKind": {
            "enum": [
              "official-standard",
              "peer-reviewed-measurement",
              "project-physical-capture",
              "engineering-target"
            ]
          },
          "source": { "type": "string", "minLength": 1 },
          "fittingMethod": { "type": "string", "minLength": 1 },
          "standardUncertainty": {
            "type": "number",
            "minimum": 0
          },
          "calibratedAt": { "type": "string", "format": "date-time" },
          "status": { "const": "accepted" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
